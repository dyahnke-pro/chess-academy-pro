  {
    "id": "mp-gambitevansgambit-attack",
    "openingId": "gambit-evans-gambit",
    "title": "The Evans Gambit: two pawns for a crushing attack",
    "criticalPositionFen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
    "overview": "The Evans is the purest attacking gambit: White hands over the b-pawn — and often a second pawn too — to rip open the centre and throw every piece at Black's king before it can castle. Don't count material; count tempo and targets. The plan is always the same and it's beautiful in its simplicity: c3 and d4 build a broad centre, the bishop and queen aim a battery at f7, Ba3 freezes the king in the middle, and the attack rolls in. Even two pawns down, White's initiative is worth far more — this is the romantic chess of Morphy and Anderssen, and at the board it scores.",
    "pawnBreaks": [
      {
        "move": "d4",
        "explanation": "The whole point of the b4/c3 sacrifice: with the bishop deflected and c3 ready, d4 builds a broad centre and tears open lines for every White piece. One pawn buys the middle of the board."
      },
      {
        "move": "e5",
        "explanation": "The follow-up lunge — kicks Black's defending knight off f6 and rips open the lines pointing at the uncastled king."
      }
    ],
    "pieceManeuvers": [
      {
        "piece": "Bishop",
        "route": "Bf1-c4 / Bc1-a3",
        "explanation": "Both bishops aim at the king. Bc4 hits f7; Ba3 rakes the a3-f8 diagonal and makes castling illegal, freezing Black's king in the centre — the signature Evans idea."
      },
      {
        "piece": "Queen",
        "route": "Qd1-b3-c3",
        "explanation": "Qb3 forms the queen+bishop battery on f7; after recapturing on c3 the queen swings onto the long dark diagonal toward the king."
      }
    ],
    "strategicThemes": [
      "Sacrifice material on purpose — the Evans buys tempo, the centre, and the attack, not a pawn back.",
      "The Bc4 + Qb3 battery on f7 is the recurring pressure point.",
      "Ba3 freezes the black king in the centre — deny castling, then attack.",
      "A lead in development with open lines beats two extra pawns when the enemy king is stuck."
    ],
