1. e4 c6 2. d4 (2. Nf3 d5 { [%cal Ge4e5,Ge4d5] } 3. Nc3 dxe4 4. Nxe4 { Game plan is same as the Classical Variation } { [%cal Gg8f6,Gc8f5] }) 2... d5 3. Nc3 (3. Nd2 { [%cal Gg8f6,Gc8f5,Ge7e6] }) (3. f3 { Fantasy Variation } 3... g6 { [%cal Gf8g7] } (3... dxe4 4. fxe4 e5 5. dxe5? Qh4+! { [%cal Gh4e1,Gh4e4] }) (3... e6) 4. Be3 Bg7 5. Nc3 { [%cal Gd5e4,Gg8f6] }) 3... dxe4! { You always take here! } 4. Nxe4 (4. f3 { [%cal Ge4f3,Gd1f3] } 4... e3 5. Bxe3 { [%csl Gf3][%cal Gg8f6,Gc8f5] }) 4... Bf5 (4... Nf6 { [%csl Gf6,Ge4] } 5. Ng3 { [%cal Gg7g6,Gf8g7,Rc8g4,Bh7h5,Bh5h4] } (5. Nxf6+ { [%csl Gf6][%cal Ge7f6,Gg7f6] } 5... exf6 { Tartakower Variation } { [%csl Gf6,Gf7][%cal Gf8d6,Ge8g8,Gf6g5] } (5... gxf6 { Bronstein-Larsen Variation } { [%cal Gh8g8,Gg8g2,Rd8c7,Rc8f5,Rb8d7,Be8c8] }))) 5. Ng3 Bg6 6. h4 { [%cal Gh4h5] } 6... h6 { [%cal Gg6h7] } *


