   "line": [
    "Bd6"
   ],
   "spoken": "The bishop belongs on d6 — now both bishops are trained on White's king, so make a mental note to watch for tactics as the game opens.",
   "kind": "main",
   "teaches": [
    "point the bishops at the king"
   ]
  },
