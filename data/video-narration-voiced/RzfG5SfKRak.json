   "line": [
    "e6"
   ],
   "spoken": "Once the bishop is chased back, the clean idea is e6 — developing and opening the diagonal for the light-squared bishop. No edge exists for the opponent in this whole line; the second player is simply fine.",
   "kind": "plan",
   "reanchor": true
