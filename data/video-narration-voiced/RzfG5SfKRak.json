   "line": [
    "Bb4+"
   ],
   "spoken": "A bishop check on b4 forces the king to f1, because blocking with c3 runs into a capture on c3 with check — the line brims with these shots precisely because the pieces are so active. Activity, not material, is doing the talking.",
   "kind": "tactic",
   "reanchor": true
  },
