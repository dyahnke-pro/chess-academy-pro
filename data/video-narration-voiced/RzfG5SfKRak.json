   "line": [
    "a6"
   ],
   "spoken": "And the move to love in the main line is a6 — Black scores a staggering fifty-nine percent from here in serious over-the-board games, an astonishing figure against the London.",
   "kind": "plan",
   "reanchor": true
  },
  {
   "ply": 11,
   "t": 3514.5,
   "fen": "rnb1kb1r/1p1ppppp/pq3n2/8/3P1B2/2N5/PPP2PPP/1R1QKBNR b Kkq - 1 6",
