   "line": [
    "Qh6",
    "Bf8",
    "Qg7+",
    "Kxg7"
   ],
   "spoken": "Here's a pattern to bank: the queen would deliver mate on the corner but for a defending bishop — so remove the bishop with a check on h6, and thanks to the pin the mate lands anyway. Clearing the last defender is the whole trick.",
   "kind": "tactic"
  },
