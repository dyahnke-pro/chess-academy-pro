   "line": [
    "e6"
   ],
   "spoken": "From there Black strikes back in the centre with Benoni-style pawn breaks — a whole world of theory.",
   "reanchor": true
  },
  {
   "ply": 16,
   "t": 661.5,
   "fen": "r1bq1rk1/pp2ppbp/3p1np1/2pPn3/2P1P3/2N1BP2/PP2N1PP/R2QKB1R w KQ - 1 9",
