   "line": [
    "Bd3"
   ],
   "spoken": "The bishop to d3 is a modern, dangerous try — but it leaves the knight on d4 loose, and that gives Black an immediate way to hit back while developing.",
   "kind": "main",
   "teaches": "When a setup leaves a central piece unsupported, strike at it at once.",
   "plans": "Attack the d4-knight and develop with tempo."
  },
  {
   "ply": 8,
   "t": 1275.5,
   "fen": "rnbqkb1r/pp2pppp/3p1n2/8/3NP3/8/PPP2PPP/RNBQKB1R w KQkq - 1 5",
