   "line": [
    "c3"
   ],
   "spoken": "The pawn to c3 — the Alapin. Instead of a theory-heavy Open Sicilian, White prepares to build a big centre with d4 and simply gets a pleasant, better position out of the opening again and again.",
   "kind": "main",
   "teaches": "The Alapin sidesteps Sicilian theory and fights for a classical pawn centre.",
   "plans": "Follow with d4 and occupy the centre."
  },
  {
   "ply": 4,
   "t": 30,
   "fen": "r1bqkbnr/pp1ppppp/2n5/2p5/4P3/2P5/PP1P1PPP/RNBQKBNR w KQkq - 1 3",
   "line": [
    "Nc6"
   ],
   "spoken": ""
  },
