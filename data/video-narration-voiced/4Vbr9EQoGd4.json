   "line": [
    "b5"
   ],
   "spoken": "A jewel of move order: play b5 before h6. The point is that after the eventual Bxc2, White has no b4 counter-deflection to hit the checking piece — the little in-between move is what makes the whole combination work.",
   "kind": "branch",
   "teaches": "Insert the quiet preparatory move first so the opponent's saving counter-resource never exists.",
   "reanchor": true
  },
