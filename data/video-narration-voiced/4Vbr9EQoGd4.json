   "line": [
    "Qa5"
   ],
   "spoken": "Qa5 develops the queen to the side, Grünfeld-style, eyeing the loose queenside while White prepares to castle long.",
   "kind": "main"
  },
  {
   "ply": 18,
   "t": 2048,
   "fen": "r1b1k2r/pp2pp1p/2n2npQ/2qp4/8/2N1P3/PPP2PPP/2KR1BNR w kq - 0 10",
   "line": [
    "O-O-O",
    "Qxc5"
   ],
   "spoken": "Just recapture on c5 — simple is best. Resist the impulsive Ng4; that's one-move-itis, the queen just slides back and we've weakened d5 for nothing.",
   "kind": "main",
   "teaches": "Don't chase a one-move threat; take the sound, simplifying recapture."
  },
  {
   "ply": 19,
   "t": 2061.5,
   "fen": "r1b1k2r/pp2pp1p/2n2npQ/2qp4/8/2N1PN2/PPP2PPP/2KR1B1R b kq - 1 10",
   "line": [
    "Nf3"
   ],
   "spoken": "Bring the bishop to g4 and trade on f3 — swapping it off increases our grip on d4 and keeps the option of planting a pawn there later.",
   "kind": "main",
   "teaches": "Trade the knight that guards a key square to take the square for yourself."
  },
