   "line": [
    "hxg5"
   ],
   "spoken": "Capture to blow open the h-file straight at the enemy king. Up to now the opponent has been calling the shots — but the moment that initiative is snuffed out, it becomes the other side's turn to attack.",
   "kind": "plan"
  },
  {
