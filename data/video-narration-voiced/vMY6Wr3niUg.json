    "Qxh6",
    "Bxh6"
   ],
   "spoken": ""
  },
  {
   "ply": 36,
   "t": 689,
   "fen": "4r1k1/p1pb1pp1/2p4B/3pr3/8/2PB2R1/P1P2PPP/R5K1 w - - 1 19",
