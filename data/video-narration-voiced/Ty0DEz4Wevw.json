   "line": [
    "Bg2"
   ],
   "spoken": "Taking on d5 is just bad. To handle it like an English, White should play the bishop to g2 — and Black can take on c4, a legitimate sideline.",
   "reanchor": true
  },
  {
   "ply": 8,
   "t": 1252.5,
