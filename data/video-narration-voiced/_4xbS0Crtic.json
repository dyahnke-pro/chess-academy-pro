   ],
   "spoken": "He declines the Stafford with the knight to c3."
  },
  {
   "ply": 6,
   "t": 45,
   "fen": "rnbqk2r/pppp1ppp/5n2/2b1p3/4P3/2N2N2/PPPP1PPP/R1BQKB1R w KQkq - 4 4",
   "line": [
