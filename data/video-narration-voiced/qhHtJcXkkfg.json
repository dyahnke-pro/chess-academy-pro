   "line": [
    "g5"
   ],
   "spoken": "The pawn to g5 chases the bishop off the board's active diagonal altogether. Booting the strong piece unburdens the position and lets Black consolidate the extra material in peace.",
   "kind": "main",
   "teaches": "When the opponent's pieces are your only problem, push them back with pawns and consolidate.",
   "plans": "Follow with d6 once the pressure eases."
  },
  {
   "ply": 29,
   "t": 349,
   "fen": "r1b2rk1/pp1pppb1/2n4p/3Nn1p1/4P3/qB4B1/P1P1NPPP/1R1Q1RK1 b - - 1 15",
