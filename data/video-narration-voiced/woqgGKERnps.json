   "line": [
    "Be3"
   ],
   "spoken": "The bishop to e3 — the 150-attack setup, rather than the f4 Austrian. With the centre in hand, we develop our pieces so they actually lend it support.",
   "kind": "plan",
   "teaches": [
    "develop to support the centre"
   ]
  },
  {
   "ply": 8,
   "t": 1141,
   "fen": "rnbqk2r/ppp1ppbp/3p1np1/8/3PP3/2N1B3/PPP2PPP/R2QKBNR w KQkq - 2 5",
