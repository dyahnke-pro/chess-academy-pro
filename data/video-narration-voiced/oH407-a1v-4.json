   "line": [
    "Bxd4"
   ],
   "spoken": "Because his king is stuck in the middle, opening lines lets us exploit it.",
   "teaches": [
    "exploit the central king"
   ]
  },
  {
   "ply": 18,
   "t": 1244.5,
