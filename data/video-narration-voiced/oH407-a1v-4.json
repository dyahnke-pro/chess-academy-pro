   "line": [
    "e4"
   ],
   "spoken": "Do we open the centre with the capture? Yes — and the reason is a principle we've hit before: his king is still in the centre and ours is already tucked away. That asymmetry is the crucial observation.",
   "kind": "plan",
   "teaches": [
    "open the centre against the uncastled king"
   ]
  },
  {
   "ply": 16,
   "t": 1239.5,
   "fen": "r1bq1rk1/pppn1pbp/3p1np1/8/3pP3/PP3N2/1BPN1PPP/R2QKB1R w KQ - 0 9",
