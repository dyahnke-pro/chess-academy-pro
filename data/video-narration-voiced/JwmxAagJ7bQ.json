   "line": [
    "Bb5"
   ],
   "spoken": "Black's bishop to g4 pins the knight, but it is a fairly toothless try. Rather than tolerate it, the bishop to b5 sidesteps the whole idea and pins Black's own knight in return.",
   "kind": "main",
   "teaches": "Answer a weak pin by creating a stronger counter-pin rather than passively unpinning.",
   "plans": "Increase the pressure on c6."
  },
