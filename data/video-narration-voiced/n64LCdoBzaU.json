   "line": [
    "O-O-O+"
   ],
   "spoken": "After the queens come off, don't rush — develop with tempo. Castling long with check is the classic device, gaining a free move while the king tucks away and leaving a full, healthy extra pawn for the endgame.",
   "kind": "plan"
  },
  {
   "ply": 20,
   "t": 1275,
   "fen": "r1b1kb1r/1p3ppp/p1n2P2/2p5/5B2/2p1P3/PPP2PPP/2KR1BNR w - - 2 11",
