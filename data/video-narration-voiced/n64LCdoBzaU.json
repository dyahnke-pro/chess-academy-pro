   "fen": "3rkbr1/1p3p1p/p1n1bp2/2pB4/2P1PB2/3R2P1/1KP1NP1P/7R b - - 5 19",
   "line": [
    "Rd3"
   ],
   "spoken": "Now a plan — the action is all on the d-file, so the classic way to press an open file is to double the rooks on it. Stack the heavy pieces where the play is.",
   "kind": "plan"
  },
  {
   "ply": 38,
   "t": 1501,
   "fen": "3rkbr1/1p3p1p/p3bp2/2pBn3/2P1PB2/3R2P1/1KP1NP1P/7R w - - 6 20",
