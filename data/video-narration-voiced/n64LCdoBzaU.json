   "fen": "r1b1kb1r/1p3ppp/p1n2P2/2p5/5B2/2P1P3/P1P2PPP/2KR1BNR b - - 0 11",
   "line": [
    "bxc3"
   ],
   "spoken": "Choose the recapture that doesn't help the opponent — taking toward the centre would only assist their development. Never do your opponent's work for them; keep their pieces cramped.",
   "kind": "plan"
  },
  {
   "ply": 20,
   "t": 1278.5,
   "fen": "r1b1kb1r/1p3ppp/p1n2P2/2p5/5B2/2p1P3/PPP2PPP/2KR1BNR w - - 2 11",
   "line": [],
