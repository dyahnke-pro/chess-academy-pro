   "t": 1377,
   "fen": "3rkbr1/1p3p1p/p1n1bp2/2pB4/2P2B2/4P1P1/P1P2P1P/2KR2NR b - - 0 15",
   "line": [
    "c4"
   ],
   "spoken": "A candid lesson from a slip — advancing the c-pawn without understanding which squares it surrenders lets the enemy knight jump to an annoying post. Practise what you preach: weigh the holes before you push.",
   "kind": "plan"
  },
  {
   "ply": 30,
   "t": 1403.5,
   "fen": "3rkbr1/1p3p1p/p3bp2/2pB4/1nP2B2/4P1P1/P1P2P1P/2KR2NR w - - 1 16",
