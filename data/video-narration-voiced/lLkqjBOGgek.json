   "fen": "r3k2r/pp1n1ppp/2pq1n2/3p1b2/3P4/2N1PN1P/PP2BPP1/R2Q1RK1 b kq - 0 11",
   "line": [
    "h3"
   ],
   "spoken": ""
  },
  {
   "ply": 22,
   "t": 363.5,
   "fen": "r4rk1/pp1n1ppp/2pq1n2/3p1b2/3P4/2N1PN1P/PP2BPP1/R2Q1RK1 w - - 1 12",
   "line": [
