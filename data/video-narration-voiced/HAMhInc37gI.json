   "line": [
    "Rfe8"
   ],
   "spoken": "There is a standard technique for a rook infiltrating to the seventh rank, worth committing to memory: the rook to e8 first, so that a rook to d7 can be met by a rook to e7.",
   "reanchor": true
  },
  {
   "ply": 43,
   "t": 587.5,
