   "line": [
    "d4",
    "d5"
   ],
   "spoken": "Absolutely classical chess today — the queen's pawn met by d5."
  },
  {
   "ply": 4,
   "t": 73.5,
   "fen": "rnbqkbnr/ppp2ppp/4p3/3p4/2PP4/8/PP2PPPP/RNBQKBNR w KQkq - 0 3",
   "line": [
    "c4",
    "e6"
   ],
   "spoken": "The Queen's Gambit, met with e6 — the Queen's Gambit Declined with Black."
  },
  {
   "ply": 5,
   "t": 76.5,
   "fen": "rnbqkbnr/ppp2ppp/4p3/3p4/2PP4/2N5/PP2PPPP/R1BQKBNR b KQkq - 1 3",
   "line": [
