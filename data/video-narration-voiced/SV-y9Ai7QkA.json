   "line": [
    "e5"
   ],
   "spoken": "One tempting move to avoid: the immediate e5 is bad, because a bishop check on b5 exploits the hole it leaves. That's the very reason a6 comes first — it prepares e5 while taking the b5 square away from that annoying check.",
   "kind": "tactic",
   "reanchor": true
  },
