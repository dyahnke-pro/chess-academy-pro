   "line": [
    "Ne5"
   ],
   "spoken": "Here's the shot to see — the enemy bishop and queen sit a knight's move apart, so a knight to e5 forks the pair. Whenever two pieces stand a knight's-distance apart, the fork should light up.",
   "kind": "tactic"
  },
  {
