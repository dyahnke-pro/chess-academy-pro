  {
   "ply": 21,
   "t": 203.5,
   "fen": "r1b1k2r/ppp1nppp/2p5/2b2P2/2B1P3/8/PqPQ2PP/RN2K2R b KQkq - 0 11",
   "line": [
    "f5"
   ],
   "spoken": "Now the queen and king sit on the same diagonal — whenever that happens, look for pins."
