  {
   "ply": 22,
   "t": 210.5,
   "fen": "r1b1k2r/ppp1nppp/2p5/2b2P2/2B1P3/8/P1PQ2PP/qN2K2R w Kkq - 0 12",
   "line": [
    "Qxa1"
   ],
   "spoken": "He never moves the rook, so we take it — up a rook and a piece."
