   "line": [
    "Bg4"
   ],
   "spoken": "The bishop to g4 is the ambitious choice — it pins the knight and leans on the center, challenging White the most. Then e6 gives us a French on steroids, bishop already outside the chain.",
   "kind": "main",
   "teaches": [
    "Bg4: the good bishop out before ...e6"
   ]
