   "fen": "rnbqkbnr/pp2ppp1/2p4p/8/2BP4/2N2N2/PPP2PPP/R1BQK2R b KQkq - 1 6",
   "line": [
    "Bc4"
   ],
   "spoken": "Start the punishment with the bishop to c4, aiming straight at the f7-pawn — the eternal soft spot when Black has spent time on the edge instead of developing.",
   "kind": "main",
   "teaches": "When Black wastes time, train the pieces on f7 at once.",
   "plans": "Add the knight to the f7 attack."
