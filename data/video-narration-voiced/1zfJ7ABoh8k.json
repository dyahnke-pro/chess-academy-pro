   "line": [
    "Nge2"
   ],
   "spoken": "The knight goes to e2, not f3 — putting it on f3 would block the very bishop we fianchettoed. Keeping the long diagonal open is the whole idea.",
   "kind": "main",
   "teaches": "Route the knight to e2 so the fianchettoed bishop breathes.",
   "plans": "Complete development, then advance the queenside."
  },
