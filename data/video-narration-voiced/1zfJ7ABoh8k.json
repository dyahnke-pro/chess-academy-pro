   "line": [
    "h3"
   ],
   "spoken": "The pawn to h3 is a no-brainer to throw in: it questions the bishop on g4 and, crucially, opens the possibility of a later g4 to harass it further — a free improving move.",
   "kind": "main",
   "teaches": "A prophylactic h3 that also unlocks g4 is a useful, low-commitment gain.",
   "plans": "Follow with development and the queenside break."
  },
