   "line": [
    "Re8"
   ],
   "spoken": "Bring the sad, out-of-play rook into the game and build Alekhine's gun — tripling the heavy pieces along the file.",
   "kind": "plan",
   "plans": "Triple queen and rooks on the file for a crushing battery."
  },
