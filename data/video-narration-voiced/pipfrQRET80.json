   "t": 611.5,
   "fen": "r1b4r/ppp1kppp/5n2/3B4/1B6/5N2/P4PPP/2KR3R b - - 3 15",
   "line": [
    "Bb4+"
   ],
   "spoken": "Before the check, insert the bishop to b4 first — denying the king its escape to f8. Not playing the obvious move immediately, and surveying all the options, is what makes the follow-up so much more efficient.",
   "kind": "tactic"
  },
  {
   "ply": 30,
   "t": 631,
   "fen": "r1bk3r/ppp2ppp/5n2/3B4/1B6/5N2/P4PPP/2KR3R w - - 4 16",
