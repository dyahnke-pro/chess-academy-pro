   "fen": "rnbqk2r/pppp1ppp/5n2/8/1bB1P3/2N5/PP3PPP/R1BQK1NR w KQkq - 1 6",
   "line": [],
   "spoken": ""
  },
  {
   "ply": 11,
   "t": 127,
   "fen": "rnbqk2r/pppp1ppp/5n2/4P3/1bB5/2N5/PP3PPP/R1BQK1NR b KQkq - 0 6",
