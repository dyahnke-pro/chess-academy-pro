   "line": [
    "Bh6"
   ],
   "spoken": "So we castle — patient, no forced sacrifices, simply completing development and increasing the pressure.",
   "kind": "main",
   "teaches": "When the pressure is building on its own, finish developing rather than forcing the issue."
