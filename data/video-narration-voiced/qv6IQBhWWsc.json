   "line": [
    "bxc6"
   ],
   "spoken": "He captures unprovoked, so you actually saved a tempo by never playing a6. The recapture opens the b-file, and don't fret the doubled pawn — one doubled pawn is nothing, and you've got the two bishops.",
   "kind": "main",
   "teaches": [
    "doubled pawns for the bishop pair"
   ]
  },
  {
