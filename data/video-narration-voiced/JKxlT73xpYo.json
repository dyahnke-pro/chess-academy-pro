   "line": [
    "Bd3"
   ],
   "spoken": "The bishop comes to d3, its most natural square, eyeing the kingside. Simple, principled development before the central tension arrives.",
   "kind": "main",
   "teaches": "Develop the bishop to its best diagonal before the middlegame breaks.",
   "plans": "Bd3, then meet ...c5 with c3."
  },
