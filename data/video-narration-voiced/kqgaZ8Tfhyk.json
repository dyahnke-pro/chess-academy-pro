   "fen": "r2qk2r/pp1b1ppp/2nbpn2/1Bpp4/8/1P1PPN2/PBP2PPP/RN1Q1RK1 w kq - 1 8",
   "line": [
    "d3",
    "Bd6"
   ],
   "spoken": "The bishop belongs on d6, the more active square — pointing toward the kingside rather than sitting passively."
  },
  {
