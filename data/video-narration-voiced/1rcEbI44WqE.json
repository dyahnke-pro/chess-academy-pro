   "line": [
    "Be3"
   ],
   "spoken": "The key restraint: do NOT push c5 to gain a tempo — that would concede the d5-square as a permanent outpost and tear a hole in the centre. Instead defend the e-pawn by developing the bishop to e3, keeping the whole pawn mass intact.",
   "kind": "main",
   "teaches": "Don't chase a tempo with a pawn push that hands the opponent a permanent hole — develop to defend instead.",
   "plans": "Hold d5 under control; develop the pieces behind the centre."
  },
  {
   "ply": 14,
   "t": 115,
   "fen": "r2qkb1r/ppp1pppp/1nn5/4Pb2/2PP4/4B3/PP4PP/RN1QKBNR w KQkq - 3 8",
