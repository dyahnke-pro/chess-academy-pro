   "t": 120.5,
   "fen": "r2qkb1r/ppp1pppp/1nn5/4Pb2/2PP4/2N1B3/PP4PP/R2QKBNR b KQkq - 4 8",
   "line": [
    "Nc3"
   ],
   "spoken": "Develop the knight to c3. It supports the centre and readies the answer to the knight jump to b4 — the rook simply steps to c1 and the intruder achieves nothing.",
   "kind": "main",
   "teaches": "Develop toward your weaknesses — the c3-knight and c1-rook cover the b4 and c-file ideas.",
   "plans": "Complete development, then expand."
  },
  {
   "ply": 16,
   "t": 124,
   "fen": "r3kb1r/pppqpppp/1nn5/4Pb2/2PP4/2N1B3/PP4PP/R2QKBNR w KQkq - 5 9",
