   ],
   "spoken": ""
  },
  {
   "ply": 10,
   "t": 808.5,
   "fen": "r1bqk1nr/pp2bppp/2np4/2p1p3/2B1P3/2NP1N2/PPP2PPP/R1BQK2R w KQkq - 1 6",
   "line": [
    "Be7"
   ],
   "spoken": "A bishop to e7 is very important — don't blunder a knight to g5.",
   "reanchor": true
  },
  {
   "ply": 9,
   "t": 811.5,
   "fen": "r1bqkbnr/pp3ppp/2np4/2p1p3/2B1P3/2NP1N2/PPP2PPP/R1BQK2R b KQkq - 0 5",
   "line": [],
