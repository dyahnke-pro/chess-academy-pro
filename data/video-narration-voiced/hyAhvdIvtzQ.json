   ],
   "spoken": ""
  },
  {
   "ply": 10,
   "t": 128.5,
   "fen": "r2qkbnr/pp3ppp/2np4/8/5Bb1/5N2/PPP1PPPP/RN1QKB1R w KQkq - 0 6",
   "line": [
    "cxd6"
   ],
   "spoken": ""
  },
  {
