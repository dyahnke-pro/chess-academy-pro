   "t": 139,
   "fen": "r2qkbnr/pp3ppp/2np4/8/5Bb1/2N2N2/PPP1PPPP/R2QKB1R b KQkq - 1 6",
   "line": [
    "Nc3"
   ],
   "spoken": "A successful opening is no licence to get arrogant — just keep developing. The knight comes to c3, and a modest pawn to e3 is preferred over the bolder advance, out of caution that the enemy queen could otherwise swing to e7 and x-ray down the file.",
   "kind": "plan"
  },
  {
   "ply": 12,
   "t": 144.5,
   "fen": "r2qkb1r/pp3ppp/2np1n2/8/5Bb1/2N2N2/PPP1PPPP/R2QKB1R w KQkq - 2 7",
