   ],
   "spoken": "The knights come out to f6 and f3 — the deeply-studied main line. Everything so far is theory, and Black stands at a major crossroads with several sound tries.",
   "kind": "main",
   "teaches": "The Qxd5 d4 Nf6 Nf3 tabiya is heavily analysed — know the branches, don't improvise.",
   "plans": "Complete development and keep the small pull."
  },
  {
   "ply": 10,
   "t": 54.5,
   "fen": "r1b1kb1r/pp2pppp/2n2n2/2pq4/3P4/2P2N2/PP3PPP/RNBQKB1R w KQkq - 3 6",
   "line": [
    "Nc6"
   ],
   "spoken": ""
  },
  {
