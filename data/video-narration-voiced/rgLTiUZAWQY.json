   "fen": "k7/6R1/PB6/1KP5/5rp1/2P5/5P2/8 b - - 4 41",
   "line": [
    "Kb5"
   ],
   "spoken": "Don't stalemate the enemy king unless you absolutely have to.",
   "reanchor": true
  },
