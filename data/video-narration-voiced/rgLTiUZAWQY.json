   "ply": 82,
   "t": 2980,
   "fen": "k4r2/6R1/PB6/1KP5/6p1/2P5/5P2/8 w - - 5 42",
   "line": [
    "Rf8"
   ],
   "spoken": "Black plays a rook to f8. Watch how I convert this.",
