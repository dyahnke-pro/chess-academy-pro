   "line": [
    "Nf6"
   ],
   "spoken": "White's d5 is bold but bad — he's simply not developed enough to hold it. Nf6 wins the pawn, since dxc6 fails to the pin.",
   "kind": "main",
   "teaches": "A pawn thrust unsupported by development is a target, not a threat — win it."
