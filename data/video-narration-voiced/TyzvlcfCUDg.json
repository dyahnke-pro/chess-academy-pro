   "line": [
    "Qh5"
   ],
   "spoken": "Qh5 is the thematic square: once White castles, Bd6 piles onto h2 for a quick mating attack — and the b4-bishop has done its job, since d5 is no longer a threat.",
   "kind": "main",
   "teaches": "Steer the queen to h5 to prepare a bishop-and-queen battery against h2."
