 "notes": [
  {
   "id": "vn-ruy-exchange-recapture-toward-the-open-file",
   "line": "e4 e5 Nf3 Nc6 Bb5 a6 Bxc6 dxc6",
   "teaches": "When a capture can be answered by either pawn, the doubled pawn is not the deciding factor — the file is. Taking toward the centre opens a line for the queen and the rook behind it, and that open file is what makes the damaged structure playable. Structure is a means; activity is the end.",
   "explains": "Taking with the d-pawn doubles the c-pawns and clears the d-file in front of the queen, with d5 and b5 both covered by the new pawn. The bishop pair is gone, and in return every piece has somewhere to go.",
   "reasons": [
    {
     "kind": "controls",
     "square": "d5"
    },
    {
     "kind": "controls",
     "square": "b5"
    }
   ],
   "fen": "r1bqkbnr/1pp2ppp/p1p5/4p3/4P3/5N2/PPPP1PPP/RNBQK2R w KQkq - 0 5",
   "t": 163,
   "ply": 8,
   "source": "yt:KwbAHRLJ1RY"
  },
  {
   "id": "vn-ruy-exchange-the-move-that-breaks-a-rule-and-works",
   "line": "e4 e5 Nf3 Nc6 Bb5 a6 Bxc6 dxc6 O-O f6",
   "teaches": "\"Never block your own knight with the f-pawn\" is a good rule and it is a rule, not a law. It holds because the move usually costs development and weakens the king. Where the knight in question has already been traded off and the king has a safe square anyway, both reasons are gone — and the move that holds your centre for free is simply the best one.",
   "explains": "The pawn to f6 defends the pawn on e5, which was the only thing hanging. The knight this move would normally block no longer exists, so nothing is being shut in.",
   "reasons": [
    {
     "kind": "defends",
     "square": "e5"
    }
   ],
   "fen": "r1bqkbnr/1pp3pp/p1p2p2/4p3/4P3/5N2/PPPP1PPP/RNBQ1RK1 w kq - 0 6",
