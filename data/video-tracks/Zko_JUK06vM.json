 "forks": [],
 "notes": [
  {
   "id": "vn-panov-develop-onto-the-pawn-that-will-become-the-target",
   "line": "e4 c6 d4 d5 exd5 cxd5 c4 Nf6 Nc3 Nc6 Nf3 Be6",
   "teaches": "A bishop that blocks its own colleague looks like a mistake and is not, provided the colleague has another route out — judge a developing move by what it HOLDS, because the pawn in the middle is the one both sides are about to fight over, and a piece defending it from the side is worth more than a tidy-looking diagonal.",
   "explains": "The bishop steps to e6 holding the pawn on d5 and the pawn on f7 behind it. It does stand in front of the other bishop, which will come out the long way instead — a route that costs a move and gains a diagonal.",
   "reasons": [
    {
     "kind": "defends",
     "square": "d5"
    },
    {
     "kind": "defends",
     "square": "f7"
    }
   ],
   "fen": "r2qkb1r/pp2pppp/2n1bn2/3p4/2PP4/2N2N2/PP3PPP/R1BQKB1R w KQkq - 5 7",
   "t": 125,
   "ply": 12,
   "source": "yt:Zko_JUK06vM"
  },
  {
   "id": "vn-panov-develop-the-queen-where-it-hits-the-defender",
   "line": "e4 c6 d4 d5 exd5 cxd5 c4 Nf6 Nc3 Nc6 Nf3 Be6 Bg5 Qa5",
   "teaches": "When a piece is pinned to the defence of a central pawn, bringing the queen out on the same diagonal does two jobs in one move: it develops, and it adds pressure to the piece that is already busy — an early queen is only bad when it can be chased, and here nothing attacks the square.",
   "explains": "The queen comes to a5 hitting the knight on c3 and adding a second defender to the pawn on d5, with the pawn on a2 in the same line. Nothing in the position can drive the queen off that square.",
   "reasons": [
    {
     "kind": "attacks",
     "square": "c3"
    },
    {
     "kind": "defends",
     "square": "d5"
    }
   ],
   "fen": "r3kb1r/pp2pppp/2n1bn2/q2p2B1/2PP4/2N2N2/PP3PPP/R2QKB1R w KQkq - 7 8",
   "t": 153,
   "ply": 14,
   "source": "yt:Zko_JUK06vM"
  },
  {
   "id": "vn-panov-recapture-toward-the-diagonal-you-still-need",
   "line": "e4 c6 d4 d5 exd5 cxd5 c4 Nf6 Nc3 Nc6 Nf3 Be6 Bg5 Qa5 Bxf6 exf6",
   "teaches": "When a capture can be answered two ways, pick the one that unlocks the piece you have not developed yet — doubling a pawn is a real cost, and it is the right price when the recapture opens the only diagonal your last minor piece has.",
   "explains": "Taking with the e-pawn doubles the f-pawns and clears e7, so the bishop still sitting at home now has the long dark diagonal to come out on. The alternative recapture keeps the pawns tidy and leaves that bishop with nowhere to go.",
   "reasons": [
    {
     "kind": "opens",
     "from": "f8",
     "to": "a3"
    }
   ],
   "fen": "r3kb1r/pp3ppp/2n1bp2/q2p4/2PP4/2N2N2/PP3PPP/R2QKB1R w KQkq - 0 9",
   "t": 159,
   "ply": 16,
   "source": "yt:Zko_JUK06vM"
  },
  {
   "id": "vn-panov-trade-off-the-piece-holding-the-isolated-pawn",
   "line": "e4 c6 d4 d5 exd5 cxd5 c4 Nf6 Nc3 Nc6 Nf3 Be6 Bg5 Qa5 Bxf6 exf6 c5 g6 Bd3 Bg7 O-O O-O a3 Bg4",
   "teaches": "Against an isolated central pawn the plan is not to attack the pawn — it is to remove its DEFENDERS one by one and then attack it. The knight in front of the king is usually the busiest of them, so the bishop that can trade itself for that knight is worth more than the bishop pair.",
   "explains": "The bishop comes to g4 pinning down the knight on f3, which is the main piece holding the pawn in the middle. Trade it off and the target has one fewer guard, with the rest of the black army already aimed that way.",
   "reasons": [
    {
     "kind": "attacks",
     "square": "f3"
    }
   ],
   "fen": "r4rk1/pp3pbp/2n2pp1/q1Pp4/3P2b1/P1NB1N2/1P3PPP/R2Q1RK1 w - - 1 13",
