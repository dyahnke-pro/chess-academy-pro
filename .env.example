# Chess Academy Pro — environment variables
#
# Copy this file to `.env.local` (gitignored) to run the app locally.
# In production (Vercel), set the same keys under:
#   Project Settings → Environment Variables
#
# Surfaces:
#   [build]     — read by Vite at build time, baked into the bundle
#                 (via `define` in vite.config.ts).
#   [vercel-fn] — read at runtime by serverless functions in `api/*`.
#   [local]     — used only by scripts in `scripts/` or by Playwright.
#
# Client-side runtime keys live in IndexedDB (encrypted via
# cryptoService) — NOT in env vars. See Settings → Coach.

# ─── LLM providers ──────────────────────────────────────────────────────────
# Optional. When set at build time, they pre-seed the coach so the
# user doesn't have to paste a key before trying the app. Users can
# still override via Settings.
# [build]
ANTHROPIC_KEY=
DEEPSEEK_KEY=

# ─── Amazon Polly TTS (server-side voice) ──────────────────────────────────
# Required for /api/tts to work. Without these, the app falls back to
# Web Speech API in-browser.
# [vercel-fn]
AWS_ACCESS_KEY_ID_POLLY=
AWS_SECRET_ACCESS_KEY_POLLY=
AWS_REGION_POLLY=us-east-1

# ─── Audit stream (Upstash Redis, optional) ─────────────────────────────────
# If set, /api/audit-stream persists client error reports into a
# short-TTL Redis list. If unset, audits stay in-memory and evaporate
# between cold starts — fine for local dev.
# [vercel-fn]
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Aliases Vercel sets automatically when using the Upstash
# integration — the handler reads either pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared secret required to POST to /api/audit-stream. Set to a long
# random string. Must match what the client sends in x-audit-secret.
# [vercel-fn]
AUDIT_STREAM_SECRET=

# ─── Scripts (local only) ──────────────────────────────────────────────────
# Used by `npm run data:audit`, grade-narrations.ts, etc. Never
# shipped to Vercel.
# [local]
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ─── Feature flags (Learn-with-Coach surface) ──────────────────────────────
# Strips the Learn-with-Coach surface back to "main line + 2-3
# variations" — hides trap tiles in the line picker, caps sibling-
# extension branches at 3 (instead of 6).
#
#   true  → simplified Learn surface (live / production)
#   false → full Learn surface with trap tiles + 6 branches (preview)
#   unset → defaults to false (preview behavior)
#
# Set per-environment in Vercel:
#   Production (main branch)     → VITE_LEARN_SIMPLIFIED=true
#   Preview (preview/* branches) → VITE_LEARN_SIMPLIFIED=false (or unset)
# [build]
VITE_LEARN_SIMPLIFIED=

# ─── PostHog product analytics (Productization Phase 1) ─────────────────────
# Client-side product analytics. When VITE_POSTHOG_KEY is unset the
# analytics layer is a complete no-op (posthog-js is never loaded) — the
# app behaves exactly as before. Get the Project API key from the PostHog
# project (Settings → Project → API key, starts `phc_`).
# Host: US cloud = https://us.i.posthog.com, EU = https://eu.i.posthog.com
# [build]
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ─── Supabase Auth (Productization Phase 3 — client) ────────────────────────
# Public values from the Supabase project (Settings → API). Safe to bake
# into the client bundle (the anon key is gated by Row-Level Security).
# Unset → auth/paywall stay disabled; the app runs as the local single-
# user app it is today.
# [build]
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── RevenueCat payments (Productization Phase 4 — client) ──────────────────
# Public SDK keys from RevenueCat (one per platform). Unset → billing is
# disabled and the paywall shows an unconfigured state.
# [build]
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_WEB_KEY=

# ─── Hard paywall master switch (Productization Phase 2) ────────────────────
# DORMANT BY DEFAULT. Set to `true` ONLY when auth + billing are wired and
# David has approved the cutover — it locks every non-Pro user (including
# David) out of the whole app until they're on trial or subscribed. Leave
# unset/false during development so the app stays fully usable.
# [build]
VITE_PAYWALL_ENABLED=

# ─── Supabase CLI ──────────────────────────────────────────────────────────
# Not needed in .env — `supabase login` + `supabase link` write a
# per-machine token under .supabase/ (gitignored). See
# supabase/README.md for the full workflow.
