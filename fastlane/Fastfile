# Fastlane — ship the Capacitor app to TestFlight from CI.
#
# The web bundle + native project are already built/synced by the workflow
# (.github/workflows/ios-testflight.yml) BEFORE this runs, so by the time the
# `beta` lane fires, ios/App/App.xcodeproj exists and the AVAudioSession
# AppDelegate patch is applied.
#
# Signing + auth:
#   * App Store Connect API key (SEC1, base64) authenticates spaceship.
#   * A PERSISTENT distribution cert + private key, generated once and stored
#     as the BUILD_CERT_P12_B64 secret (base64 .p12), is imported into the CI
#     keychain — fastlane's `cert` can't be used on ephemeral CI because the
#     private key it generates is lost when the job ends (orphaning a cert each
#     run, hitting Apple's 2-cert cap).
#   * The App Store provisioning profile is created/downloaded via the API key.
#   * The TestFlight UPLOAD is done by the workflow via `xcrun altool` (PKCS#8
#     key) — NOT here — because altool rejects the SEC1 key spaceship needs.
#
# See docs/ios-testflight-ci.md for the one-time setup.

default_platform(:ios)

# Capacitor 8 uses Swift Package Manager (no CocoaPods), so there is NO
# .xcworkspace — build the project directly.
PROJECT = 'ios/App/App.xcodeproj'
SCHEME = 'App'
APP_ID = 'com.chessacademy.pro'
TEAM_ID = '7KATVL9274'
# Marketing version (CFBundleShortVersionString). The committed repo carries no
# xcodeproj (cap add regenerates it to Capacitor's "1.0" default each build), so
# this is the source of truth — bump it for a new App Store version.
APP_VERSION = '3.2'

platform :ios do
  desc 'Build a signed App Store IPA (upload handled by the workflow via altool)'
  lane :beta do
    # Ephemeral keychain so the imported signing cert never persists on the runner.
    setup_ci

    # spaceship parses SEC1 EC keys cleanly (its OpenSSL::PKey::EC.new chokes on
    # PKCS#8 → "invalid curve name"). So the build/auth here uses the SEC1 form;
    # the TestFlight UPLOAD is done by the workflow via `xcrun altool` with the
    # PKCS#8 form, which altool requires. One format per tool, no conflict.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('APP_STORE_CONNECT_API_KEY_ID'),
      issuer_id: ENV.fetch('APP_STORE_CONNECT_API_ISSUER_ID'),
      key_content: ENV.fetch('APP_STORE_CONNECT_API_KEY_B64'),
      is_key_content_base64: true,
      in_house: false,
    )

    # Import the persistent distribution cert + private key (.p12 decoded to a
    # file by the workflow) into the keychain setup_ci created.
    import_certificate(
      certificate_path: ENV.fetch('CERT_P12_PATH'),
      certificate_password: ENV.fetch('CERT_P12_PASSWORD'),
      keychain_name: ENV.fetch('MATCH_KEYCHAIN_NAME', 'fastlane_tmp_keychain'),
      keychain_password: ENV.fetch('MATCH_KEYCHAIN_PASSWORD', ''),
    )

    # App Store provisioning profile for this bundle id (created if missing).
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_ID,
      adhoc: false,
      readonly: false,
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    # Marketing version — set explicitly because `cap add ios` regenerates the
    # iOS project every build and RESETS the version to Capacitor's "1.0"
    # default. The repo commits no xcodeproj, so the real App Store version
    # (2.8) lived only in App Store Connect — which is why the macOS-runner
    # builds landed under a stray "1.0" train and never appeared under 2.8
    # (David 2026-06-21: "we are on version 2.8 ... send build 70"). Bump this
    # string for a new version.
    app_version = APP_VERSION
    increment_version_number(
      version_number: app_version,
      xcodeproj: 'ios/App/App.xcodeproj',
    )

    # Sequential build number: next after the latest TestFlight build for THIS
    # version (so 2.8's build 69 → 70, then 71…). Replaces the Unix-timestamp
    # scheme that made TestFlight show 10-digit build numbers.
    build_no = latest_testflight_build_number(
      app_identifier: APP_ID,
      version: app_version,
      api_key: api_key,
      initial_build_number: 0,
    ) + 1
    increment_build_number(
      xcodeproj: 'ios/App/App.xcodeproj',
      build_number: build_no,
    )
    UI.message("Version #{app_version}, build number set to #{build_no}")

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: 'app-store',
      # The Capacitor project ships with no DEVELOPMENT_TEAM, so the manual-
      # signing archive needs the team + cert + profile passed explicitly.
      xcargs: %Q(DEVELOPMENT_TEAM=#{TEAM_ID} CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER="#{profile_name}" CODE_SIGN_IDENTITY="Apple Distribution"),
      export_options: {
        provisioningProfiles: { APP_ID => profile_name },
        signingStyle: 'manual',
      },
      output_directory: 'build',
      clean: true,
    )

    # Upload is handled by the workflow's `xcrun altool` step (PKCS#8 key) —
    # fastlane's upload_to_testflight reuses the SEC1 api_key, which altool
    # rejects. The signed build/App.ipa produced here is what gets uploaded.
    UI.success("Built signed IPA: #{lane_context[SharedValues::IPA_OUTPUT_PATH]}")
  end

  desc 'Upload App Store listing metadata + screenshots (NO binary, NO submit). '\
       'David finishes privacy/age/IAP/submit in App Store Connect.'
  lane :upload_listing do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('APP_STORE_CONNECT_API_KEY_ID'),
      issuer_id: ENV.fetch('APP_STORE_CONNECT_API_ISSUER_ID'),
      key_content: ENV.fetch('APP_STORE_CONNECT_API_KEY_B64'),
      is_key_content_base64: true,
      in_house: false,
    )
    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      app_version: APP_VERSION,
      metadata_path: './fastlane/metadata',
      screenshots_path: './fastlane/screenshots',
      skip_binary_upload: true,        # no IPA — the build already shipped via the beta lane
      # Text metadata uploaded fine on the first run; the screenshot/review step
      # hit a known spaceship bug (fetch_app_store_review_detail "No data" on a
      # brand-new version). Skip metadata so the screenshots upload via their own
      # clean code path. Flip back to false once the version has review detail.
      skip_metadata: ENV['DELIVER_SKIP_METADATA'] != 'false',
      overwrite_screenshots: true,
      submit_for_review: false,        # account-gated final submit stays with David
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      force: true,                     # no interactive HTML preview in CI
    )
    UI.success('Listing metadata + screenshots uploaded. Finish privacy/age/IAP/submit in App Store Connect.')
  end
end

# ── Android / Google Play ────────────────────────────────────────────────────
# Auth: a Google Play Developer API SERVICE ACCOUNT JSON (analog of the ASC API
# key). The CI workflow decodes PLAY_SERVICE_ACCOUNT_JSON_B64 to a file and
# points PLAY_JSON_KEY_PATH at it. The signed .aab is built by the workflow
# (./gradlew bundleRelease) BEFORE these lanes run.
#
# NOTE: supply CANNOT create the app — the Play Console app must already exist
# and the service account must be granted access. The very first AAB usually has
# to be uploaded by hand in the console; after that these lanes drive it.
PLAY_PACKAGE = 'com.chessacademy.pro'
PLAY_AAB = 'android/app/build/outputs/bundle/release/app-release.aab'

platform :android do
  desc 'Upload the signed .aab to a Play track (default: internal, draft). '\
       'Set PLAY_TRACK / PLAY_RELEASE_STATUS to override.'
  lane :play_beta do
    upload_to_play_store(
      package_name: PLAY_PACKAGE,
      json_key: ENV.fetch('PLAY_JSON_KEY_PATH'),
      aab: PLAY_AAB,
      track: ENV.fetch('PLAY_TRACK', 'internal'),
      release_status: ENV.fetch('PLAY_RELEASE_STATUS', 'draft'),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
    UI.success("Uploaded #{PLAY_AAB} to the #{ENV.fetch('PLAY_TRACK', 'internal')} track.")
  end

  desc 'Upload Play store listing (text + graphics), NO binary. '\
       'David finishes content-rating / data-safety / pricing / submit in the console.'
  lane :play_listing do
    upload_to_play_store(
      package_name: PLAY_PACKAGE,
      json_key: ENV.fetch('PLAY_JSON_KEY_PATH'),
      metadata_path: './fastlane/metadata/android',
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: false,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
    )
    UI.success('Play listing metadata + graphics uploaded. Finish content-rating / data-safety / pricing / submit in the console.')
  end
end
