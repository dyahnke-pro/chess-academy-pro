node_modules
dist
.DS_Store
*.local
.env
.env.*
!.env.example
# .env.production is committed on purpose — it holds ONLY the PUBLIC VITE_ client
# analytics vars (already in the browser bundle) so the iOS/Capacitor build,
# which has no access to Vercel project env, ships PostHog instead of a no-op.
!.env.production
# ios/ is generated by Capacitor (regenerated in CI), so the tree is ignored —
# EXCEPT ios/App/ci_scripts/, which must be committed there so Xcode Cloud finds
# the post-clone hook (Xcode Cloud looks for ci_scripts adjacent to the
# .xcodeproj, not at the repo root).
/ios/*
!/ios/App
/ios/App/*
!/ios/App/ci_scripts
# Capacitor-generated Android platform — regenerated in CI (npm run
# setup:android) from android-patches/. Anchored with a leading slash so it
# ONLY ignores the root platform dir, NOT paths like fastlane/metadata/android.
/android
coverage
playwright-report
test-results
*.tsbuildinfo
.claude/*
!.claude/settings.json
public/stockfish/*.js
public/stockfish/*.wasm
# WO-STOCKFISH-SWAP — lila-bridge.worker.js is source-controlled
# (it's our adapter, not auto-copied from node_modules).
!public/stockfish/lila-bridge.worker.js
.netlify/
src/data/annotations-all.json
voice_packs/
missing_clips.txt
.supabase/
.vercel
.env*.local
audit-reports/
docs/audits/

# Interactive-loop audit transient outputs (regenerated each run; read live, not versioned)
docs/audit-runs/2026-05-19-openings-interactive-loop/findings-round-*.json
docs/audit-runs/2026-05-19-openings-interactive-loop/findings-aggregate.json
docs/audit-runs/2026-05-19-openings-interactive-loop/screenshots/
docs/audit-runs/2026-05-19-openings-interactive-loop/checkpoint*.json

# ship-check local watermark (green-run SHA + timestamp; used by --summary)
.ship-check-log/

# Pro-repertoire raw game corpora — regeneratable via
# scripts/pro-repertoire/fetch-chesscom.mjs (~500MB per pro).
data/sources/*-chesscom/
# OTB corpora: raw pgnmentor downloads + the derived jsonl the reference
# builder ingests are regeneratable (extract-caruana-otb.mjs / fetch-otb-games.mjs).
# The committed artifact is src/data/pro-game-references.json.
data/sources/*-pgnmentor/
data/sources/*-otb/
# Per-signature stats are huge (~100MB for a prolific player). They're
# regeneratable via scripts/pro-repertoire/analyze-games.mjs once the
# raw corpus is in place. The committed derived artifacts are the
# family rollup + per-opening trees + voice notes (all <600KB each).
data/sources/*-stats.json
data/sources/*-families.json
# Voice research: the auto-mined digests are ignored; the hand-curated *.md
# notes are committed.
#
# TRANSCRIPTS ARE NOW COMMITTED, gzipped, under data/video-transcripts/ (David
# 2026-08-17: *"everything that we get access to gets saved ... there are often
# more than one idea stated after each move, or if something else goes wrong.
# save it all!"*). A note is written from ONE idea at a move, and the transcript
# is where the others still live — so re-visiting a narration needs the source
# that produced it, and this container is ephemeral. The plagiarism guard is
# unchanged and is about SHIPPING, not storing: transcripts are reference only,
# never quoted, never shipped as narration. Storing them is what makes the
# reference checkable; it is the raw *.vtt working copies that stay out.
data/sources/*-voice/transcripts/
data/sources/*-voice/digests/
data/sources/carlsen-alts/

# Raw public-domain book OCR caches (re-fetched by build-library-*.mjs)
data/sources/*.txt

# All raw public-domain book sources (re-fetched by build-library-*.mjs)
data/sources/
# NB: a creator's video manifest lives under this ignored tree but IS tracked
# (force-added). A negation pattern cannot re-include it — git never descends
# into an excluded directory — so manifests are added with `git add -f`, and
# once tracked their changes are diffed normally. This matters: the weekly
# corpus-manifest-refresh cron was a SILENT NO-OP until 2026-07-31 because it
# ran plain `git add` on an untracked, ignored path and exited green.

# Ruby / fastlane — CI installs gems via bundler-cache; the vendored bundle is a
# local cache (98 MB) and Gemfile.lock is generated per-Ruby (this container's
# 3.3.0 differs from CI's 3.2), so neither belongs in git. Gemfile stays tracked.
vendor/
Gemfile.lock
.bundle/

src/data/main-line-cache.json
src/data/main-line-report.json
src/data/spine-continuation-report.json
src/data/spine-eval-cache.json
src/data/grounding-respine-proposals.json
src/data/spine-report-lessons.json
src/data/spine-report-repertoire.json
src/data/spine-report-plans.json

# The in-repo Capacitor plugin ships its built dist (consumed by the app's
# tsc/vite build in CI); it must be tracked despite the global `dist` rule above.
!native-plugins/capacitor-stockfish-native/dist/
!native-plugins/capacitor-stockfish-native/dist/**
.env*

# Scratch audit runners (parallel-session throwaways)
scripts/_*.mjs
.pull-status.json

# Per-shard bake outputs — merged into public/data/corpus-spoken.json, never committed raw.
.bake/

# video-align: raw video + extracted frames are research inputs, never shipped
*.mp4
*.webm
scripts/video-align/frames/

# Python bytecode — regenerated on import, and version-specific
__pycache__/
*.pyc
