!.env.example
# ios/ is generated by Capacitor (regenerated in CI), so the tree is ignored —
# EXCEPT ios/App/ci_scripts/, which must be committed there so Xcode Cloud finds
# the post-clone hook (Xcode Cloud looks for ci_scripts adjacent to the
# .xcodeproj, not at the repo root).
/ios/*
!/ios/App
/ios/App/*
!/ios/App/ci_scripts
android
coverage
playwright-report
test-results
*.tsbuildinfo
.claude/*
!.claude/settings.json
public/stockfish/*.js
public/stockfish/*.wasm
# WO-STOCKFISH-SWAP — lila-bridge.worker.js is source-controlled
# (it's our adapter, not auto-copied from node_modules).
!public/stockfish/lila-bridge.worker.js
.netlify/
src/data/annotations-all.json
voice_packs/
missing_clips.txt
.supabase/
.vercel
.env*.local
audit-reports/
docs/audits/

# Interactive-loop audit transient outputs (regenerated each run; read live, not versioned)
docs/audit-runs/2026-05-19-openings-interactive-loop/findings-round-*.json
docs/audit-runs/2026-05-19-openings-interactive-loop/findings-aggregate.json
docs/audit-runs/2026-05-19-openings-interactive-loop/screenshots/
docs/audit-runs/2026-05-19-openings-interactive-loop/checkpoint*.json

# ship-check local watermark (green-run SHA + timestamp; used by --summary)
.ship-check-log/

# Pro-repertoire raw game corpora — regeneratable via
# scripts/pro-repertoire/fetch-chesscom.mjs (~500MB per pro).
data/sources/*-chesscom/
# OTB corpora: raw pgnmentor downloads + the derived jsonl the reference
# builder ingests are regeneratable (extract-caruana-otb.mjs / fetch-otb-games.mjs).
# The committed artifact is src/data/pro-game-references.json.
data/sources/*-pgnmentor/
data/sources/*-otb/
# Per-signature stats are huge (~100MB for a prolific player). They're
# regeneratable via scripts/pro-repertoire/analyze-games.mjs once the
# raw corpus is in place. The committed derived artifacts are the
# family rollup + per-opening trees + voice notes (all <600KB each).
data/sources/*-stats.json
data/sources/*-families.json
# Voice research: only the raw transcript pulls are ignored; the
# hand-curated *.md notes are committed.
data/sources/*-voice/transcripts/
data/sources/carlsen-alts/

# Raw public-domain book OCR caches (re-fetched by build-library-*.mjs)
data/sources/*.txt

# All raw public-domain book sources (re-fetched by build-library-*.mjs)
data/sources/

# Ruby / fastlane — CI installs gems via bundler-cache; the vendored bundle is a
# local cache (98 MB) and Gemfile.lock is generated per-Ruby (this container's
# 3.3.0 differs from CI's 3.2), so neither belongs in git. Gemfile stays tracked.
vendor/
Gemfile.lock
.bundle/
